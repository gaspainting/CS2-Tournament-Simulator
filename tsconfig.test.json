{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": ["src/majorEngine.ts", "src/domain/**/*.ts", "src/data/**/*.ts", "src/engine/**/*.ts", "src/state/operations.ts", "src/state/persistenceGuard.ts"]
}
